# Copy to .env and fill in. Never commit .env.

# --- LLM (https://console.groq.com/keys, free tier) ---
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
CLASSIFIER_MODEL=openai/gpt-oss-20b
PROMPT_GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
DEMO_MODE=true

# --- LangSmith (https://smith.langchain.com, free tier) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=secure-rag-assistant

# --- Cost controls ---
DAILY_TOKEN_QUOTA=200000

# --- Infra (docker-compose sets sensible defaults for these) ---
QDRANT_URL=http://localhost:6333
USAGE_BACKEND=dynamodb
DYNAMODB_ENDPOINT=http://localhost:8001
AWS_REGION=us-east-1
EMF_ENABLED=false

# --- docker-compose host ports (change if they clash with other local services) ---
QDRANT_HOST_PORT=6333
DYNAMODB_HOST_PORT=8001
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=3000
