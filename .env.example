# Copy to .env and fill in. Never commit .env.

# --- LLM (https://console.groq.com/keys, free tier) ---
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
CLASSIFIER_MODEL=openai/gpt-oss-20b
PROMPT_GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m

# --- Retrieval ---
# Cross-encoder reranker over fused candidates; leave empty to disable.
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RELEVANCE_THRESHOLD=0.62
# Deny when a restricted doc out-scores the best authorized one by this reranker margin
# (or by the similarity margin when the reranker is disabled).
RESTRICTED_RERANK_MARGIN=1.5
RESTRICTED_MARGIN=0.05

# --- Evals (Ragas judges; kept off the assistant's own models and quota) ---
JUDGE_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-safeguard-20b

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
DEMO_MODE=true

# --- LangSmith (https://smith.langchain.com, free tier) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=secure-rag-assistant

# --- Cost controls ---
DAILY_TOKEN_QUOTA=200000

# --- Infra (docker-compose sets sensible defaults for these) ---
QDRANT_URL=http://localhost:6333
USAGE_BACKEND=dynamodb
DYNAMODB_ENDPOINT=http://localhost:8001
AWS_REGION=us-east-1
EMF_ENABLED=false

# --- docker-compose host ports (change if they clash with other local services) ---
QDRANT_HOST_PORT=6333
DYNAMODB_HOST_PORT=8001
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=3000
